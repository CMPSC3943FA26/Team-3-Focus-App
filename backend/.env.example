# Copy this file to .env and fill in your own values.
# The real .env is gitignored and must never be committed.

# development, testing, or production
FLASK_ENV=development

# Used to sign sessions. Any random string is fine for local work.
SECRET_KEY=replace-me-with-a-random-string

# SQLite is the local default and needs no setup. The team has not picked a
# production database yet, so this stays configurable.
DATABASE_URL=sqlite:///focusapp.db
